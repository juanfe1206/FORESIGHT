# FORESIGHT — environment variable reference
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; this file is tracked.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Public base URL (used for absolute links / OG tags / redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Simulation API (Epic 2)
# ---------------------------------------------------------------------------

# Internal endpoint for the /api/simulate route (leave blank to use mock path)
# SIMULATE_API_ENDPOINT=

# API key for the upstream simulation service
# SIMULATE_API_KEY=

# ---------------------------------------------------------------------------
# AI / Agent runtime (Epic 2)
# ---------------------------------------------------------------------------

# Primary server-side LLM API key used by /api/simulate route
# LLM_API_KEY=

# Legacy alias (deprecated): OPENAI_API_KEY -> LLM_API_KEY
# OPENAI_API_KEY=

# Model names used by the simulation pipeline
# LLM_MODEL_PARSE_CLASSIFY=gpt-4o-mini
# LLM_MODEL_AGENT=gpt-4o-mini
# LLM_MODEL_SYNTHESIS=gpt-4o-mini

# Simulation settings
# SIMULATION_TIMEOUT_MS=30000

# Mapbox token (used in map stories)
# MAPBOX_ACCESS_TOKEN=

# Enables fixture replay path for debugging/demo flows
# ENABLE_GOLDEN_REPLAY=false

# ---------------------------------------------------------------------------
# Mapbox (client-side map tiles — URL-restrict the token in Mapbox dashboard)
# ---------------------------------------------------------------------------

# Public token for react-map-gl in the browser (required prefix NEXT_PUBLIC_)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------

# Set to "true" to enable the dev UI shell preview bar in production builds
# (normally suppressed via NODE_ENV check)
# NEXT_PUBLIC_FORCE_DEV_PREVIEW=
