# FORESIGHT — environment variable reference
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; this file is tracked.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Public base URL (used for absolute links / OG tags / redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Simulation API (Epic 2 — not yet wired)
# ---------------------------------------------------------------------------

# Internal endpoint for the /api/simulate route (leave blank to use mock path)
# SIMULATE_API_ENDPOINT=

# API key for the upstream simulation service
# SIMULATE_API_KEY=

# ---------------------------------------------------------------------------
# AI / Agent runtime (Epic 2 — not yet wired)
# ---------------------------------------------------------------------------

# OpenAI-compatible API key used by agent runner
# OPENAI_API_KEY=

# Model to use for agent roles (defaults used when unset)
# AGENT_MODEL_DECISION_PARSER=gpt-4o
# AGENT_MODEL_SYNTHESIS=gpt-4o-mini

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------

# Set to "true" to enable the dev UI shell preview bar in production builds
# (normally suppressed via NODE_ENV check)
# NEXT_PUBLIC_FORCE_DEV_PREVIEW=
